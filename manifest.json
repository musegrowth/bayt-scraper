{
  "manifest_version": 3,
  "name": "Bayt Job Scraper",
  "version": "1.0.0",
  "description": "Bulk-search Bayt.com from a CSV (Search_Text + Location) and export every job listing found to a CSV file.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "tabs"
  ],

  "host_permissions": [
    "https://www.bayt.com/*",
    "https://bayt.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Bayt Job Scraper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
